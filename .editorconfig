# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.sh]
indent_size = 2

# YAML forbids tabs for indentation.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,jsonc,json5}]
indent_style = space
indent_size = 2

# One object per line; indentation never applies.
[*.jsonl]
indent_style = unset
indent_size = unset

[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf

# Bundled templates and resources are copied verbatim into outputs.
[**/assets/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[{LICENSE*,NOTICE*}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
