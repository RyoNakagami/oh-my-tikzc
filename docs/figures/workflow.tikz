#| mainfont: IPAexGothic
% The steps SKILL.md asks the agent to follow for a new scan.
\begin{tikzpicture}[
  block/.style={draw=blue!65!black,fill=blue!7,rounded corners=3pt,
    align=center,minimum width=3cm,minimum height=1.2cm,inner sep=7pt},
  entry/.style={block,line width=1.6pt},
  store/.style={block,shape=cylinder,shape border rotate=90,aspect=0.25,
    draw=green!45!black,fill=green!8,rounded corners=0pt},
  external/.style={block,draw=gray!75!black,fill=gray!8,dashed},
  concern/.style={block,draw=red!70!black,fill=red!6,
    dash pattern=on 5pt off 2pt on 1pt off 2pt,
    label={[font=\footnotesize\bfseries,text=red!70!black,inner sep=3pt]45:!}},
  context/.style={block,draw=gray!70,fill=white,text=gray!30!black,dotted},
  rel/.style={font=\footnotesize,fill=white,inner sep=2pt},
  >={Stealth[length=2.5mm]},font=\small,line width=0.7pt
]
  % White background so the figure stays readable on dark themes.
  \path[fill=white] (-2.30,-8.63) rectangle (14.63,3.96);
  \node[external] (repo) at (0,3) {Target repository\\manifests, entry points};
  \node[entry] (scope) at (0,0) {1. Establish scope\\config.yaml, HEAD};
  \node[block] (perspectives) at (6,0) {2. Choose perspectives\\overall-architecture + \dots};
  \node[block] (tree) at (12,0) {3. Build the tree\\group or leaf per node};
  \node[block] (write) at (12,-3.6) {4. Write files\\description.md, meta.yaml,\\diagram.tikz};
  \node[block] (render) at (6,-3.6) {5. Render and inspect\\tikzc check, SVG/PNG};
  \node[block] (validate) at (0,-3.6) {6. Stamp and check\\omtkc.py stamp, check};
  \node[store] (omtkc) at (0,-7) {.omtkc/\\commit with the code};

  \draw[->] (repo) -- node[rel,right] {read} (scope);
  \draw[->] (scope) -- node[rel,above] {scope} (perspectives);
  \draw[->] (perspectives) -- node[rel,above] {questions} (tree);
  \draw[->] ([xshift=8mm]tree.north) -- ++(0,0.9) -| node[rel,pos=0.25,above] {drill into groups} ([xshift=-8mm]tree.north);
  \draw[->] (tree) -- node[rel,right] {nodes + sources} (write);
  \draw[->] ([yshift=3mm]write.west) -- node[rel,above] {diagram.tikz} ([yshift=3mm]render.east);
  \draw[->] ([yshift=-3mm]render.east) -- node[rel,below] {fix layout} ([yshift=-3mm]write.west);
  \draw[->] (render) -- node[rel,above] {inspected} (validate);
  \draw[->] (validate) -- node[rel,right] {no errors} (omtkc);
\end{tikzpicture}
