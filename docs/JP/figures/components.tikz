#| mainfont: IPAexGothic
% oh-my-tikzc 実行時の役割分担．すべてのステップを AI エージェントが駆動する．
\begin{tikzpicture}[
  block/.style={draw=blue!65!black,fill=blue!7,rounded corners=3pt,
    align=center,minimum width=3cm,minimum height=1.2cm,inner sep=7pt},
  entry/.style={block,line width=1.6pt},
  store/.style={block,shape=cylinder,shape border rotate=90,aspect=0.25,
    draw=green!45!black,fill=green!8,rounded corners=0pt},
  external/.style={block,draw=gray!75!black,fill=gray!8,dashed},
  concern/.style={block,draw=red!70!black,fill=red!6,
    dash pattern=on 5pt off 2pt on 1pt off 2pt,
    label={[font=\footnotesize\bfseries,text=red!70!black,inner sep=3pt]45:!}},
  context/.style={block,draw=gray!70,fill=white,text=gray!30!black,dotted},
  rel/.style={font=\footnotesize,fill=white,inner sep=2pt},
  >={Stealth[length=2.5mm]},font=\small,line width=0.7pt
]
  % White background so the figure stays readable on dark themes.
  \path[fill=white] (-1.86,-5.89) rectangle (15.86,4.55);
  \node[external] (user) at (0,0) {ユーザー\\チャットで依頼};
  \node[entry] (agent) at (6,0) {AIコーディングエージェント\\Claude Code / Codex};
  \node[block] (skill) at (6,3.4) {スキルパッケージ\\SKILL.md, references/,\\assets/, scripts/};
  \node[external] (repo) at (6,-3.6) {対象リポジトリ\\ソースコード + git};
  \node[store] (omtkc) at (13,0) {.omtkc/\\description.md, meta.yaml,\\diagram.tikz/.svg/.png};
  \node[external] (tikzc) at (13,3.6) {tikzc CLI\\check, 描画};
  \node[block] (checker) at (13,-3.6) {omtkc.py\\check, tree, stale, stamp};

  \draw[->] (user) -- node[rel,above] {依頼} (agent);
  \draw[->] (skill) -- node[rel,right] {手順 + フォーマット規約} (agent);
  \draw[->] (repo) -- node[rel,right] {ソースと HEAD を読む} (agent);
  \draw[->] (agent) -- node[rel,above] {ファイルを書く} (omtkc);
  \draw[->] ([xshift=-6mm]omtkc.north) -- node[rel,left] {diagram.tikz} ([xshift=-6mm]tikzc.south);
  \draw[->] ([xshift=6mm]tikzc.south) -- node[rel,right] {SVG / PNG} ([xshift=6mm]omtkc.north);
  \draw[->] ([xshift=-6mm]omtkc.south) -- node[rel,left] {ツリーを検証} ([xshift=-6mm]checker.north);
  \draw[->] ([xshift=6mm]checker.north) -- node[rel,right] {render を記録} ([xshift=6mm]omtkc.south);
  \draw[->] (repo) -- node[rel,above] {git diff} (checker);
  \node[font=\footnotesize,text=gray!30!black] (_note) at (6,-5.3) {tikzc と omtkc.py はエージェントが実行する（手動でも実行できる）．};
\end{tikzpicture}
